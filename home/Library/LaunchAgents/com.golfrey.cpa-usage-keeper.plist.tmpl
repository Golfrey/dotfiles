{{- $profile := get . "profile" | default "personal" -}}
{{- if eq $profile "server" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.golfrey.cpa-usage-keeper</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ joinPath .chezmoi.homeDir ".local" "share" "cpa-usage-keeper" "cpa-usage-keeper" }}</string>
    <string>-env</string>
    <string>{{ joinPath .chezmoi.homeDir ".config" "cpa-usage-keeper" "env" }}</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{ joinPath .chezmoi.homeDir ".local" "share" "cpa-usage-keeper" }}</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{ joinPath .chezmoi.homeDir "Library" "Logs" "cpa-usage-keeper.log" }}</string>
  <key>StandardErrorPath</key>
  <string>{{ joinPath .chezmoi.homeDir "Library" "Logs" "cpa-usage-keeper.err.log" }}</string>
</dict>
</plist>
{{- end }}
